# Netlify response headers for jaihindconclave.com
# Filenames are not content-hashed, so HTML/CSS/JS keep Netlify's default "revalidate every visit"
# (cheap 304s, deploys show up instantly). Images/video are cached for 7 days (+1 day served-stale
# while revalidating). Self-hosted fonts and version-named vendor libraries never change: immutable.
# If you replace an image but keep its filename, returning visitors may see the old one for up to 7 days.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/optimized/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/sponsors/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/jhc_hero_optimized.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/hero_mobile.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/jbc-wordmark-white.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/jbc-logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
